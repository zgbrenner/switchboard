{
  "name": "switchboard-mcp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first local MCP server for AI request planning, model routing, diagnostics, evaluation, and aggregate preference learning.",
  "bin": {
    "switchboard-mcp": "mcp/index.mjs"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "models:fetch:core": "node scripts/fetch-models.mjs core",
    "models:fetch:all": "node scripts/fetch-models.mjs all",
    "models:fetch:judge": "node scripts/fetch-models.mjs judge",
    "models:verify": "node scripts/verify-models.mjs",
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run mcp:smoke",
    "verify:extension": "node scripts/verify-extension.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify:python": "python -m unittest discover -s training/tests -v && python -m compileall -q training",
    "prepare:training": "python -m training.prepare_data",
    "package": "npm run verify && node scripts/package-release.mjs",
    "mcp:start": "node mcp/index.mjs --transport=stdio",
    "mcp:http": "node mcp/index.mjs --transport=http",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
